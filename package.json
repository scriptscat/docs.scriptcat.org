{
  "name": "scriptcat-org",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start:zh": "docusaurus start --locale zh-Hans",
    "start:en": "docusaurus start --locale en --port 3001",
    "start:ru": "docusaurus start --locale ru --port 3002",
    "prebuild": "node scripts/fetch-landing-stats.mjs || true",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "check:urls": "node scripts/check-url-inventory.mjs",
    "check:fallbacks": "node scripts/check-i18n-fallbacks.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "check:i18n-ui": "node scripts/check-i18n-ui.mjs",
    "check:frontmatter": "node scripts/check-frontmatter.mjs",
    "check": "npm run check:urls && npm run check:fallbacks && npm run check:i18n && npm run check:i18n-ui && npm run check:frontmatter"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-client-redirects": "^3.10.1",
    "@docusaurus/plugin-google-gtag": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@gracefullight/docusaurus-plugin-tailwind": "^1.0.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^1.2.1",
    "motion": "^14.14.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@docsearch/react": "^4.7.0",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "@iconify-icons/logos": "^2.0.0",
    "@iconify-icons/lucide": "^2.0.4",
    "@iconify-icons/mingcute": "^2.0.0",
    "@iconify-icons/octicon": "^2.0.1",
    "@iconify/react": "^4.1.1",
    "@tsconfig/docusaurus": "^1.0.5",
    "@types/react": "^18.2.29",
    "typescript": "~5.2.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "packageManager": "pnpm@10.9.0+sha512.0486e394640d3c1fb3c9d43d49cf92879ff74f8516959c235308f5a8f62e2e19528a65cdc2a3058f587cde71eba3d5b56327c8c33a97e4c4051ca48a10ca2d5f"
}
